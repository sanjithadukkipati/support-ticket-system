{
	"info": {
		"_postman_id": "8a7c2b5e-4f10-4822-9211-1a3b5c6d7e8f",
		"name": "Support Ticket System API",
		"description": "Complete Postman test collection for Support Ticket System REST API endpoints, role-based authorization checks, and error cases.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000/api",
			"type": "string"
		},
		{
			"key": "customerToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "agentToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "ticketId",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "1. Login Customer (Success)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "2. Login Agent (Success)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"agent@example.com\",\n  \"password\": \"agentpass123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "3. Login Invalid Credentials (401)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"wrongpassword\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "4. Register New Customer (201)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"customer\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					}
				}
			]
		},
		{
			"name": "Tickets",
			"item": [
				{
					"name": "1. Create Ticket (Customer - 201)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{customerToken}}", "type": "string" }
							]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"subject\": \"Unable to export analytics reports to CSV\",\n  \"description\": \"Clicking Export CSV triggers an infinite loading spinner on the reports page.\",\n  \"priority\": \"high\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/tickets",
							"host": ["{{baseUrl}}"],
							"path": ["tickets"]
						}
					}
				},
				{
					"name": "2. Get Customer Tickets (Customer - 200)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{customerToken}}", "type": "string" }
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/tickets",
							"host": ["{{baseUrl}}"],
							"path": ["tickets"]
						}
					}
				},
				{
					"name": "3. Get All Tickets (Agent - 200)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{agentToken}}", "type": "string" }
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/tickets",
							"host": ["{{baseUrl}}"],
							"path": ["tickets"]
						}
					}
				},
				{
					"name": "4. Filter Tickets by Status (Agent - 200)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{agentToken}}", "type": "string" }
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/tickets?status=open",
							"host": ["{{baseUrl}}"],
							"path": ["tickets"],
							"query": [
								{ "key": "status", "value": "open" }
							]
						}
					}
				},
				{
					"name": "5. Get Ticket By ID (Owner Customer - 200)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{customerToken}}", "type": "string" }
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/tickets/{{ticketId}}",
							"host": ["{{baseUrl}}"],
							"path": ["tickets", "{{ticketId}}"]
						}
					}
				},
				{
					"name": "6. Get Ticket By ID - Unauthorized Ticket Access (403 Forbidden)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{customerToken}}", "type": "string" }
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/tickets/3",
							"host": ["{{baseUrl}}"],
							"path": ["tickets", "3"]
						}
					}
				},
				{
					"name": "7. Get Non-Existent Ticket (404 Not Found)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{customerToken}}", "type": "string" }
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/tickets/99999",
							"host": ["{{baseUrl}}"],
							"path": ["tickets", "99999"]
						}
					}
				},
				{
					"name": "8. Update Ticket Status & Assignee (Agent - 200)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{agentToken}}", "type": "string" }
							]
						},
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"in_progress\",\n  \"priority\": \"high\",\n  \"assigned_to\": 3\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/tickets/1",
							"host": ["{{baseUrl}}"],
							"path": ["tickets", "1"]
						}
					}
				},
				{
					"name": "9. Update Ticket Status (Customer - 403 Forbidden)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{customerToken}}", "type": "string" }
							]
						},
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"closed\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/tickets/1",
							"host": ["{{baseUrl}}"],
							"path": ["tickets", "1"]
						}
					}
				},
				{
					"name": "10. Missing Token Authorization (401 Unauthorized)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/tickets",
							"host": ["{{baseUrl}}"],
							"path": ["tickets"]
						}
					}
				}
			]
		},
		{
			"name": "Comments",
			"item": [
				{
					"name": "1. Get Comments for Ticket (200)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{customerToken}}", "type": "string" }
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/tickets/2/comments",
							"host": ["{{baseUrl}}"],
							"path": ["tickets", "2", "comments"]
						}
					}
				},
				{
					"name": "2. Add Comment to Ticket (201)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{agentToken}}", "type": "string" }
